print("✅ Veri seti indirildi!")

import glob

yaml_files = glob.glob("/content/**/data.yaml", recursive=True)

if yaml_files:
    data_path = yaml_files[0]
    print(f"✅ Veri ayar dosyası bulundu: {data_path}")
else:
    print("❌ HATA: data.yaml bulunamadı. Lütfen 2. hücreyi tekrar çalıştır.")

from ultralytics import YOLO

model = YOLO('yolov8n.pt')


results = model.train(
    data=data_path,
    epochs=50,
    imgsz=640,
    name='atik_modeli'
)

from google.colab import files
import os

print("⏳ Model TFLite formatına çevriliyor...")

model.export(format='tflite')

